# Copy to .env in the API / CLI working directory and fill private values.
# QWEN_BASE_URL must include /v1; no /chat/completions suffix.
QWEN_BASE_URL=
QWEN_LAN_API_KEY=
QWEN_MODEL=
QWEN_TIMEOUT_SECONDS=120
TIMEZONE=Asia/Shanghai
# Optional override; leave empty to use the bundled JPL de440s.bsp.
ASTRO_EPHEMERIS_PATH=

# Same variables as doonook_temp: leave POSTGRES_HOST pointing to local PG.
# Replica nodes must set REMOTE_WRITER_HOST to the primary private-network host.
DOONOOK_NODE_ROLE=primary
REMOTE_WRITER_HOST=

# Credentials, port and database are shared between local replica and primary.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chinese_calendar

# Optional: only the separate huangli date API uses this third-party key.
# Horoscope generation never uses it.
JISU_API_KEY=
